# ==========================================================
# Agent Rez — Environment Variables
# ==========================================================
# Copy this file to .env.local and fill in your values.
# ==========================================================

# ----------------------------------------------------------
# Supabase Connection (Required)
# ----------------------------------------------------------
# Your Supabase project URL (e.g. https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""

# Your Supabase anon/public key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Your Supabase service role key (server-side only, never expose to client)
# Required for server-side operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------
# Groq API (Required for AI features)
# ----------------------------------------------------------
# Obtain your API key from the Groq console (https://console.groq.com)
GROQ=""

# ----------------------------------------------------------
# PDF Export — Chromium Binary (Required for server-side PDF)
# ----------------------------------------------------------
# URL to the @sparticuz/chromium-min binary pack for serverless Puppeteer.
# Defaults to v131.0.1 from GitHub releases if not set.
# Override if you self-host the binary or use a different version.
CHROMIUM_PACK_URL="https://github.com/Sparticuz/chromium/releases/download/v131.0.1/chromium-v131.0.1-pack.tar"

# ----------------------------------------------------------
# Application URL (Optional)
# ----------------------------------------------------------
# The canonical URL where this app is hosted.
# Used for CSRF origin validation and OpenGraph metadata.
# Vercel auto-sets VERCEL_URL; set this for custom domains.
APP_URL=""
